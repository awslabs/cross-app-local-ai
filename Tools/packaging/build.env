# Tools/packaging/build.env — project-level build configuration.
#
# Sourced by build_pkg.sh. All customizable values live here so OSS
# forks only need to edit this file (and Distribution.xml for the
# installer UI) rather than modifying the build script itself.
#
# Environment variables of the same name override these defaults,
# allowing CI to inject values without touching this file.

# APP_NAME is the user-facing product name: it names the built FastLang.app
# and the FastLang-<version>.pkg installer. PROJECT_NAME and SCHEME are the
# Xcode project/scheme, generated from project.yml. BUNDLE_ID is the app's
# reverse-DNS identity (com.aws.fastlang); the app performs a one-time
# migration of data from the previous bundle ID on first launch.
APP_NAME="${APP_NAME:-FastLang}"
PROJECT_NAME="${PROJECT_NAME:-FastLang}"
SCHEME="${SCHEME:-FastLang}"
BUNDLE_ID="${BUNDLE_ID:-com.aws.fastlang}"
CONFIGURATION="${CONFIGURATION:-Release}"
VERSION="${VERSION:-0.3.0-local}"
MARKETING_VERSION="${MARKETING_VERSION:-}"
BUILD_NUMBER="${BUILD_NUMBER:-}"
MIN_MACOS="${MIN_MACOS:-14.0}"

# Telemetry API. Empty values disable telemetry (OSS builds).
# CI injects a per-build token via environment variables.
TELEMETRY_API_DOMAIN="${TELEMETRY_API_DOMAIN:-}"
TELEMETRY_API_TOKEN="${TELEMETRY_API_TOKEN:-}"
