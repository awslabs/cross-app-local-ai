<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The Bedrock credential helper runs WITHOUT App Sandbox. This is
	  intentional and is the only reason this XPC service exists: the
	  sandboxed main app cannot exec the user's configured
	  credential_process binary (a standard AWS mechanism; Amazon's
	  internal isengardcli is one example, not a requirement), so we
	  delegate that exec to a separate, unsandboxed process. The threat
	  model relaxes M8 for this single binary; the main app's sandbox
	  remains intact.

	  No entitlements are needed. The absence of app-sandbox means the
	  helper runs with the user's normal access rights.
	-->
</dict>
</plist>
