# XcodeGen — the Xcode project is GENERATED from project.yml (the source of
# truth) and must not be committed or hand-edited. Run `make generate`
# (or `xcodegen generate`) after editing project.yml or a fresh checkout.
# The one exception is Package.resolved: it's kept for reproducible SPM
# dependency resolution (see engineering-standards / threat model M7).
/FastLang.xcodeproj/*
!/FastLang.xcodeproj/project.xcworkspace
/FastLang.xcodeproj/project.xcworkspace/*
!/FastLang.xcodeproj/project.xcworkspace/xcshareddata
/FastLang.xcodeproj/project.xcworkspace/xcshareddata/*
!/FastLang.xcodeproj/project.xcworkspace/xcshareddata/swiftpm
/FastLang.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/FastLang.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
